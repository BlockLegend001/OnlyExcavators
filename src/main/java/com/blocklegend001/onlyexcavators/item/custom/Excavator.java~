package com.blocklegend001.onlyexcavators.item.custom;

import com.mojang.blaze3d.systems.RenderSystem;
import net.minecraft.client.Minecraft;
import net.minecraft.client.multiplayer.ClientLevel;
import net.minecraft.client.player.LocalPlayer;
import net.minecraft.core.BlockPos;
import net.minecraft.core.Direction;
import net.minecraft.tags.BlockTags;
import net.minecraft.world.item.DiggerItem;
import net.minecraft.world.item.ToolMaterial;
import net.minecraft.world.level.ClipContext;
import net.minecraft.world.phys.AABB;
import net.minecraft.world.phys.BlockHitResult;
import net.minecraft.world.phys.HitResult;
import org.lwjgl.opengl.GL11;

import java.util.ArrayList;
import java.util.List;

public class Excavator extends DiggerItem {
    public Excavator(ToolMaterial pTier, float attackDamage, float attackSpeed, Properties pProperties) {
        super(pTier, BlockTags.MINEABLE_WITH_SHOVEL, attackDamage, attackSpeed, pProperties);
    }

    public static void renderExcavatorBorder(ClientLevel level, BlockPos centerPos, int range) {
        List<BlockPos> positions = Excavator.getBlocksToBeDestroyed(range, centerPos, Minecraft.getInstance().player);

        RenderSystem.getModelViewMatrix();
        RenderSystem.lineWidth(2.0F);  // Imposta la larghezza della linea del bordo
        RenderSystem.deleteTexture(0);
        RenderSystem.enableBlend();
        RenderSystem.defaultBlendFunc();
        GL11.glColor4f(1.0F, 1.0F, 1.0F, 1.0F);  // Imposta il colore del bordo a bianco

        // Cicla su tutte le posizioni da visualizzare
        for (BlockPos pos : positions) {
            AABB boundingBox = new AABB(pos).inflate(0.01D);  // Per disegnare una linea sottilissima
            // Draw the box at each corner
            drawBoundingBox(boundingBox);
        }

        RenderSystem.disableBlend();
        RenderSystem.activeTexture(1);
        RenderSystem.getTextureMatrix();
    }

    // Funzione che disegna un quadrato attorno a un blocco
    private static void drawBoundingBox(AABB boundingBox) {
        // Disegna il bordo della zona
        Minecraft.getInstance().getEntityRenderDispatcher().getRenderer(Minecraft.getInstance().player)
                .createRenderState();  // Colore bianco per il bordo
    }

    public static List<BlockPos> getBlocksToBeDestroyed(int range, BlockPos initalBlockPos, LocalPlayer player) {
        List<BlockPos> positions = new ArrayList<>();

        BlockHitResult traceResult = player.level().clip(new ClipContext(player.getEyePosition(1f),
                (player.getEyePosition(1f).add(player.getViewVector(1f).scale(6f))),
                ClipContext.Block.COLLIDER, ClipContext.Fluid.NONE, player));
        if(traceResult.getType() == HitResult.Type.MISS) {
            return positions;
        }

        if(traceResult.getDirection() == Direction.DOWN || traceResult.getDirection() == Direction.UP) {
            for(int x = -range; x <= range; x++) {
                for(int y = -range; y <= range; y++) {
                    positions.add(new BlockPos(initalBlockPos.getX() + x, initalBlockPos.getY(), initalBlockPos.getZ() + y));
                }
            }
        }

        if(traceResult.getDirection() == Direction.NORTH || traceResult.getDirection() == Direction.SOUTH) {
            for(int x = -range; x <= range; x++) {
                for(int y = -range; y <= range; y++) {
                    positions.add(new BlockPos(initalBlockPos.getX() + x, initalBlockPos.getY() + y, initalBlockPos.getZ()));
                }
            }
        }

        if(traceResult.getDirection() == Direction.EAST || traceResult.getDirection() == Direction.WEST) {
            for(int x = -range; x <= range; x++) {
                for(int y = -range; y <= range; y++) {
                    positions.add(new BlockPos(initalBlockPos.getX(), initalBlockPos.getY() + y, initalBlockPos.getZ() + x));
                }
            }
        }
        return positions;
    }
}